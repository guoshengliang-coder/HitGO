# Copy to .env next to docker-compose.yml. All variables are optional except where noted.

# Data root inside the container (mounted from ./data). Do not change with compose.
DATA_DIR=/data

# SQLite by default: sqlite:////data/hitgo.db. For PostgreSQL:
# DATABASE_URL=postgresql+psycopg://hitgo:secret@db:5432/hitgo
DATABASE_URL=

# Celery broker/backend. Compose overrides this to redis://redis:6379/0.
REDIS_URL=redis://localhost:6379/0

# Non-empty → every /api and /media request needs cookie hitgo_access=<code>.
ACCESS_CODE=

# Used to build absolute output URLs in the callback JSON (no trailing slash).
PUBLIC_BASE_URL=https://hitgo.mrlgs.net

# Optional upload host that bypasses the CDN (no trailing slash), e.g.
# https://hitgo-upload.mrlgs.net. Cloudflare's free plan rejects uploads over 100 MB;
# when set, the browser sends asset and batch-video uploads there with a short-lived
# path-bound ticket. The API allows CORS from PUBLIC_BASE_URL. Empty = same-origin.
UPLOAD_BASE_URL=

# How long a read ticket for one /media file stays valid (seconds, HIG-58). The voice-cloning
# endpoint fetches the sample itself from the public internet, so the worker signs a ticket for
# that one path; /media is otherwise behind ACCESS_CODE.
MEDIA_TICKET_TTL_SECONDS=1800

# Parallel ffmpeg renders per worker container.
WORKER_CONCURRENCY=1

# dev | prod. dev enables CORS for the Vite dev server (http://localhost:5173).
ENV=prod

# Override ffmpeg/ffprobe binaries if not on PATH.
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# Vocals / instrumental separation (separator container only). torch threads per job and
# the longest source audio accepted, in seconds; longer sources fail fast.
SEPARATE_THREADS=4
SEPARATE_MAX_SECONDS=600

# 改语言（听写 → 翻译 → 配音，阿里云百炼；普通 worker 执行，纯网络调用）。没配 key 时前端禁用该模块。
DASHSCOPE_API_KEY=
# dashscope | fake（fake 只用于测试 / 演示：假听写、假翻译、静音配音）
LOCALIZE_PROVIDER=dashscope
LOCALIZE_ASR_MODEL=paraformer-realtime-v2
LOCALIZE_MT_MODEL=qwen-mt-plus
# 把直译改写成自然、适合朗读且接近原句时长的本地化台词（HIG-73）
LOCALIZE_SCRIPT_MODEL=qwen-plus
LOCALIZE_TTS_MODEL=cosyvoice-v3-flash
# 接受的最长源视频（秒）；配音最多加速到几倍以塞进原句时段；单个任务的软超时（秒）
LOCALIZE_MAX_SECONDS=600
LOCALIZE_MAX_TEMPO=1.3
LOCALIZE_TIMEOUT_SECONDS=900
# 按语言覆盖 / 新增默认音色：lang=voice[@model]，如 ko=loongjihun_v3,ar=loongmary@qwen-audio-3.0-tts-flash；
# 每种语言只取一条，放到该语言音色列表最前面（成为缺省）；不带 @model 的音色属于 LOCALIZE_TTS_MODEL。
# 内置音色表在 backend/app/services/localize.py DEFAULT_VOICES（中文约 30 个 cosyvoice-v3-flash 音色）；
# 西 / 葡 / 法 / 德 / 意 / 俄默认走 qwen3-tts-flash（Cherry / Serena / Ethan）。试听缓存在 DATA_DIR/tts-preview/。
LOCALIZE_VOICES=
# 百炼托管的 MiniMax 语音模型（HIG-59），第二家系统音色来源，仍用上面的 DASHSCOPE_API_KEY，不需要 MiniMax 自己的 key。
# 可选 MiniMax/speech-2.8-hd | MiniMax/speech-2.8-turbo | MiniMax/speech-02-hd | MiniMax/speech-02-turbo；
# 仅华北2（北京）地域提供，需先在百炼控制台开通该模型。turbo 2 元/万字符、hd 3.5 元/万字符（cosyvoice 约 0.8-1 元）。
# 缺省留空 = 不提供 MiniMax 音色：音色表里的 MiniMax 条目全部过滤掉，泰语 / 越南语 / 阿拉伯语也随之退出目标
# 语言列表，界面与接 MiniMax 之前完全一致。**要开启必须先在百炼控制台开通 MiniMax 语音模型**，否则界面上会
# 出现这些音色但每次合成都 502（未开通时百炼回 400 "The product is not activated"），后端无法预先判断。
MINIMAX_TTS_MODEL=
# 大字报重点词挑选用的对话模型（与 DASHSCOPE_API_KEY / LOCALIZE_PROVIDER 共用）
HIGHLIGHT_MODEL=qwen-plus

# 画面文字本地化（识别 → 翻译 → 擦除，HIG-38）。识别与翻译沿用上面的 DASHSCOPE_API_KEY，
# 不配 key 时前端禁用该模块。provider 缺省跟随 LOCALIZE_PROVIDER；fake 只用于测试。
SCREENTEXT_PROVIDER=
# 视觉模型。qwen-vl-max-latest 通用、JSON 格式更稳；qwen-vl-ocr 更便宜、专做 OCR，返回结构不同，
# 换之前要改 dashscope_providers.parse_detection_json。真机上比过效果再决定默认值。
SCREENTEXT_MODEL=qwen-vl-max-latest
# 抽帧密度与上限。费用按帧算，抽完还会做一次感知去重（静止画面的重复帧直接丢掉），
# 一条 60 秒视频典型送去识别的是 8–14 帧。
SCREENTEXT_SAMPLE_FPS=0.5
SCREENTEXT_MAX_FRAMES=20
# 一条视频最多保留多少个画面文字块（超出按面积取前 N）；接受的最长源视频（秒）；单个任务软超时（秒）
SCREENTEXT_MAX_BLOCKS=40
SCREENTEXT_MAX_SECONDS=180
SCREENTEXT_TIMEOUT_SECONDS=1200
# 擦除供应商。local = ffmpeg delogo，不出网、不需要任何凭据，从源片按区域插值补画面：
# 比遮盖层好，比真正的无痕修复差，是这个功能的保底档，也是云厂商不可用时的降级。
# fake 只用于测试。接入云厂商后在这里填它的标识，并配上它自己的 key。
ERASE_PROVIDER=local
# 云端擦除是异步任务：每隔多少秒轮询一次、总共等多久（超过就判失败，防止云端任务丢了卡死）
ERASE_POLL_INTERVAL_SECONDS=10
ERASE_MAX_WAIT_SECONDS=1800
