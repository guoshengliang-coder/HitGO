# Copy to .env next to docker-compose.yml. All variables are optional except where noted.

# Data root inside the container (mounted from ./data). Do not change with compose.
DATA_DIR=/data

# SQLite by default: sqlite:////data/hitgo.db. For PostgreSQL:
# DATABASE_URL=postgresql+psycopg://hitgo:secret@db:5432/hitgo
DATABASE_URL=

# Celery broker/backend. Compose overrides this to redis://redis:6379/0.
REDIS_URL=redis://localhost:6379/0

# Non-empty → every /api and /media request needs cookie hitgo_access=<code>.
ACCESS_CODE=

# Used to build absolute output URLs in the callback JSON (no trailing slash).
PUBLIC_BASE_URL=https://hitgo.mrlgs.net

# Optional upload host that bypasses the CDN (no trailing slash), e.g.
# https://hitgo-upload.mrlgs.net. Cloudflare's free plan rejects uploads over 100 MB;
# when set, the browser sends asset uploads there with a short-lived ticket and the
# API allows CORS from PUBLIC_BASE_URL. Empty = uploads stay same-origin.
UPLOAD_BASE_URL=

# Parallel ffmpeg renders per worker container.
WORKER_CONCURRENCY=1

# dev | prod. dev enables CORS for the Vite dev server (http://localhost:5173).
ENV=prod

# Override ffmpeg/ffprobe binaries if not on PATH.
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
